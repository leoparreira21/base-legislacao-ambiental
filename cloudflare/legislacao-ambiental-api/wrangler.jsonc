{
  "name": "legislacao-ambiental-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  // Logs do Worker (Workers Logs). Fica ligado aqui: cada deploy aplica esta
  // configuração e sobrescreve a do painel do Cloudflare.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
